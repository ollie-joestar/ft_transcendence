# vault/backend.env.ctmpl
# -----------------------
# Vault Agent template that renders backend environment variables.
#
# - Reads values from KV v2 path: secret/data/backend
# - Renders shell exports for backend ENTRYPOINT.sh consumption
# - Destination is configured in vault/agent.hcl: /secrets/backend.env
#
# [Docs] https://developer.hashicorp.com/vault/docs/agent-and-proxy/agent/template

{{ with secret "secret/data/backend" }}
export JWT_SECRET="{{ .Data.data.JWT_SECRET }}"
export JWT_REFRESH_SECRET="{{ .Data.data.JWT_REFRESH_SECRET }}"
export DATABASE_URL="{{ .Data.data.DATABASE_URL }}"
{{ end }}
