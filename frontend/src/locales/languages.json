  "aboutus": {
    "eyebrow": {
      "en": "The Team",
      "de": "Das Team",
      "ja": "チーム"
    },
    "title": {
      "en": "THE CREW",
      "de": "DIE CREW",
      "ja": "クルー"
    },
    "subtitle": {
      "en": "Students from 42, one capstone, and a shared refusal to ship anything that isn't fun to drive.",
      "de": "Studierende von 42, ein Abschlussprojekt und der gemeinsame Anspruch, nichts auszuliefern, das keinen Fahrspaß macht.",
      "ja": "42の学生たち、ひとつの集大成、そして「運転して楽しくないものは出さない」という共通の信念。"
    },
    "projectLabel": {
      "en": "The Project",
      "de": "Das Projekt",
      "ja": "プロジェクト"
    },
    "projectTitle": {
      "en": "Built at 42",
      "de": "Entwickelt bei 42",
      "ja": "42で開発"
    },
    "projectBody": {
      "en": "Sakura Drift is our ft_transcendence: the capstone project of the 42 common core. The brief was open: a full-stack, real-time multiplayer web application. We chose to build something we'd actually want to play. Every layer, from the physics to the petals, is ours.",
      "de": "Sakura Drift ist unser ft_transcendence: das Abschlussprojekt des 42 Common Core. Die Vorgabe war offen: eine Full-Stack-Echtzeit-Multiplayer-Webanwendung. Wir wollten etwas bauen, das wir selbst spielen würden. Jede Schicht, von der Physik bis zu den Blütenblättern, stammt von uns.",
      "ja": "Sakura Driftは私たちのft_transcendence、42コモンコアの集大成プロジェクトです。課題は自由でした：フルスタックのリアルタイム・マルチプレイヤーWebアプリ。私たちは自分たちが本当に遊びたいものを作ることを選びました。物理から花びらまで、すべての層が私たちのものです。"
    },
    "teamLabel": {
      "en": "The Team",
      "de": "Das Team",
      "ja": "チーム"
    },
    "teamTitle": {
      "en": "Who built it",
      "de": "Wer es gebaut hat",
      "ja": "開発メンバー"
    },
    "roleFullstack": {
      "en": "Fullstack & DevOps",
      "de": "Fullstack & DevOps",
      "ja": "フルスタック & DevOps"
    },
    "roleGame": {
      "en": "Game & 3D Graphics",
      "de": "Spiel & 3D-Grafik",
      "ja": "ゲーム & 3Dグラフィック"
    },
    "roleCyber": {
      "en": "Cybersecurity",
      "de": "Cybersicherheit",
      "ja": "サイバーセキュリティ"
    },
    "roleAI": {
      "en": "AI & Fullstack",
      "de": "KI & Fullstack",
      "ja": "AI & Fullstack"
    },
    "stackLabel": {
      "en": "The Stack",
      "de": "Der Stack",
      "ja": "技術スタック"
    },
    "stackTitle": {
      "en": "What it runs on",
      "de": "Worauf es läuft",
      "ja": "使用技術"
    }
  },
  "aboutgame": {
    "eyebrow": {
      "en": "The Game",
      "de": "Das Spiel",
      "ja": "ゲーム"
    },
    "title": {
      "en": "SAKURA DRIFT",
      "de": "SAKURA DRIFT",
      "ja": "SAKURA DRIFT"
    },
    "subtitle": {
      "en": "A low-poly multiplayer arcade racer built around the art of the drift — and a leaderboard worth fighting for.",
      "de": "Ein Low-Poly-Multiplayer-Arcade-Racer rund um die Kunst des Driftens — und eine Rangliste, für die es sich zu kämpfen lohnt.",
      "ja": "ドリフトの技を中心に据えたローポリのマルチプレイヤー・アーケードレーサー。そして、競う価値のあるリーダーボード。"
    },
    "premiseLabel": {
      "en": "The Premise",
      "de": "Die Prämisse",
      "ja": "コンセプト"
    },
    "premiseTitle": {
      "en": "MASTER THE TRACK",
      "de": "BEHERRSCHE DIE STRECKE",
      "ja": "コースを極めろ"
    },
    "premiseBody": {
      "en": "Sakura Drift drops you into a minimalistic racetrack. No realism for its own sake; just momentum and the line. Learn a corner, then learn to carry speed through it. The track doesn't care about your lap time until you do.",
      "de": "Sakura Drift wirft dich auf eine minimalistische Rennstrecke. Kein Realismus um seiner selbst willen; nur Schwung und die Ideallinie. Lerne eine Kurve, dann lerne, Tempo durch sie mitzunehmen. Die Strecke kümmert sich erst um deine Rundenzeit, wenn du es tust.",
      "ja": "Sakura Driftは、あなたをミニマルなレースコースへと放り込む。リアルさのためのリアルさはない。あるのは勢いとライン取りだけ。コーナーを覚え、そこを速度を保ったまま抜ける術を覚えろ。コースは、あなたが気にするまであなたのタイムを気にしない。"
    },
    "featuresLabel": {
      "en": "Features",
      "de": "Funktionen",
      "ja": "特徴"
    },
    "featuresTitle": {
      "en": "What's under the hood",
      "de": "Was unter der Haube steckt",
      "ja": "中身を覗いてみよう"
    },
    "feature1Title": {
      "en": "Real-time racing",
      "de": "Echtzeit-Rennen",
      "ja": "リアルタイムレース"
    },
    "feature1Body": {
      "en": "Multiplayer over a low-latency socket layer. Positions and drifts sync live.",
      "de": "Multiplayer über eine latenzarme Socket-Schicht. Positionen und Drifts synchronisieren live.",
      "ja": "低遅延のソケット層によるマルチプレイヤー。位置とドリフトがライブで同期する。"
    },
    "feature2Title": {
      "en": "Minimalistic tracks",
      "de": "Minimalistische Strecken",
      "ja": "ミニマルなコース"
    },
    "feature2Body": {
      "en": "Hand-built low-poly racetracks in Three.js",
      "de": "Handgebaute Low-Poly-Rennstrecken in Three.js",
      "ja": "Three.jsで手作りしたローポリのコース"
    },
    "feature3Title": {
      "en": "Drift scoring",
      "de": "Drift-Wertung",
      "ja": "ドリフトスコア"
    },
    "feature3Body": {
      "en": "Hold the angle, chain the corners, bank the smoke. Style feeds your score as much as the clock does.",
      "de": "Halte den Winkel, verkette die Kurven, sammle den Rauch. Stil zählt für deinen Score genauso wie die Uhr.",
      "ja": "アングルを保ち、コーナーを連ね、煙を稼げ。スタイルはタイムと同じくらいスコアを左右する。"
    },
    "feature4Title": {
      "en": "Sakura aesthetic",
      "de": "Sakura-Ästhetik",
      "ja": "桜の美学"
    },
    "feature4Body": {
      "en": "A washi-and-crimson world with falling petals. Arcade feel, Japanese soul, zero HUD clutter.",
      "de": "Eine Welt aus Washi und Karmesinrot mit fallenden Blütenblättern. Arcade-Gefühl, japanische Seele, kein HUD-Wirrwarr.",
      "ja": "和紙と紅に舞い散る花びらの世界。アーケードの手触り、日本の心、ごちゃつかないHUD。"
    },
    "modesLabel": {
      "en": "Modes",
      "de": "Modi",
      "ja": "モード"
    },
    "modesTitle": {
      "en": "Three ways to race",
      "de": "Drei Arten zu fahren",
      "ja": "3つのレースの楽しみ方"
    },
    "mode1Tag": {
      "en": "Quick Race",
      "de": "Schnelles Rennen",
      "ja": "クイックレース"
    },
    "mode1Title": {
      "en": "Jump straight in",
      "de": "Sofort loslegen",
      "ja": "すぐに飛び込む"
    },
    "mode1Body": {
      "en": "Matchmaking drops you onto the grid against whoever is online right now.",
      "de": "Das Matchmaking setzt dich gegen alle, die gerade online sind, an den Start.",
      "ja": "マッチメイキングが、今オンラインの相手とのグリッドへあなたを送り込む。"
    },
    "mode2Tag": {
      "en": "Lobbies",
      "de": "Lobbys",
      "ja": "ロビー"
    },
    "mode2Title": {
      "en": "Bring your rivals",
      "de": "Bring deine Rivalen mit",
      "ja": "ライバルを呼べ"
    },
    "mode2Body": {
      "en": "Spin up a private room, share the code, settle it among friends.",
      "de": "Erstelle einen privaten Raum, teile den Code, macht es unter Freunden aus.",
      "ja": "プライベートルームを立て、コードを共有し、仲間内で決着をつけろ。"
    },
    "mode3Tag": {
      "en": "Time Trial",
      "de": "Zeitfahren",
      "ja": "タイムトライアル"
    },
    "mode3Title": {
      "en": "Chase the ghost",
      "de": "Jage den Geist",
      "ja": "ゴーストを追え"
    },
    "mode3Body": {
      "en": "Race the clock and your own best line. No traffic, no excuses. Just you and the ghost of the past.",
      "de": "Fahre gegen die Uhr und deine eigene Ideallinie. Kein Verkehr, keine Ausreden. Nur du und der Geist der Vergangenheit.",
